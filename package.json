{
  "name": "monet-tauri",
  "version": "1.0.4",
  "private": true,
  "description": "Monet — Multi-engine mission control for coding agents (Claude Code and Codex today)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zenolab124/monet.git"
  },
  "homepage": "https://github.com/zenolab124/monet",
  "bugs": "https://github.com/zenolab124/monet/issues",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "dev:full": "pnpm mcp:build && pnpm dev",
    "build": "vue-tsc --noEmit && vite build",
    "build:full": "pnpm mcp:build:release && pnpm build",
    "mcp:build": "cargo build --bin monet-mcp --manifest-path src-tauri/Cargo.toml",
    "mcp:build:release": "cargo build --release --bin monet-mcp --manifest-path src-tauri/Cargo.toml",
    "preview": "vite preview",
    "tauri": "bash scripts/tauri-cli.sh",
    "release": "bash scripts/release.sh",
    "version": "bash scripts/sync-version.sh"
  },
  "author": "Zeno",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "claude",
    "session-manager",
    "tauri",
    "vue",
    "macos"
  ],
  "packageManager": "pnpm@10.18.2",
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.20",
    "@iconify-json/simple-icons": "^1.2.93",
    "@tauri-apps/cli": "^2.10.1",
    "@types/diff": "^8.0.0",
    "@types/markdown-it": "^14.1.2",
    "@unocss/preset-icons": "^66.6.8",
    "@unocss/preset-wind4": "^66.6.8",
    "@unocss/transformer-directives": "^66.6.8",
    "@unocss/transformer-variant-group": "^66.6.8",
    "@vitejs/plugin-vue": "^6.0.5",
    "typescript": "^6.0.2",
    "unocss": "^66.6.8",
    "vite": "^8.0.8",
    "vitest": "^4.1.10",
    "vue": "^3.5.32",
    "vue-tsc": "^3.2.6"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/vue": "^0.5.0",
    "@mdit/plugin-katex": "^1.0.2",
    "@shikijs/markdown-it": "^4.0.2",
    "@tanstack/vue-virtual": "^3.13.34",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "diff": "^9.0.0",
    "html2canvas-pro": "2.3.8",
    "katex": "^0.18.1",
    "markdown-it": "^14.3.0",
    "shiki": "^4.0.2",
    "vue-i18n": "^11.4.5"
  }
}
